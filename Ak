local function CreateTargetToggle(name, desc, yPos, callback)
    local row = Instance.new("Frame", TargetContainer)
    row.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    row.Position = UDim2.new(0, 0, 0, yPos)
    row.Size = UDim2.new(1, 0, 0, 55)
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
    
    local titleLab = Instance.new("TextLabel", row)
    titleLab.Position = UDim2.new(0, 12, 0, 6)
    titleLab.Size = UDim2.new(0, 280, 0, 22)
    titleLab.Text = name
    titleLab.TextColor3 = Color3.new(1, 1, 1)
    titleLab.Font = Enum.Font.SourceSansBold
    titleLab.TextSize = 14
    titleLab.BackgroundTransparency = 1
    titleLab.TextXAlignment = Enum.TextXAlignment.Left
    
    local descLab = Instance.new("TextLabel", row)
    descLab.Position = UDim2.new(0, 12, 0, 26)
    descLab.Size = UDim2.new(0, 310, 0, 20)
    descLab.Text = desc
    descLab.TextColor3 = Color3.fromRGB(170, 170, 170)
    descLab.Font = Enum.Font.SourceSans
    descLab.TextSize = 11
    descLab.BackgroundTransparency = 1
    descLab.TextXAlignment = Enum.TextXAlignment.Left
    
    local switch = Instance.new("TextButton", row)
    switch.Position = UDim2.new(1, -65, 0.5, -15)
    switch.Size = UDim2.new(0, 55, 0, 30)
    switch.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    switch.Text = "OFF"
    switch.TextColor3 = Color3.new(1, 1, 1)
    switch.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)
    
    local state = false
    switch.MouseButton1Click:Connect(function()
        state = not state
        if state then
            switch.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            switch.Text = "ON"
        else
            switch.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            switch.Text = "OFF"
        end
        callback(state)
    end)
end

