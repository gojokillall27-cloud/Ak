    isNoDashCD = isOn
    if isNoDashCD then
        pcall(function()
            local oldTick = tick
            local fakeTime = oldTick()
            hookfunction(tick, function(...)
                if isNoDashCD then
                    fakeTime = fakeTime + 100
                    return fakeTime
                end
                return oldTick(...)
            end)
        end)
