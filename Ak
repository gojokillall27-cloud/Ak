targetDropdownBtn.MouseButton1Click:Connect(function()
    playerListFrame.Visible = not playerListFrame.Visible
    if playerListFrame.Visible then
        for _, child in ipairs(playerListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                count = count + 1
                local pBtn = Instance.new("TextButton", playerListFrame)
                pBtn.Size = UDim2.new(1, -10, 0, 30)
                pBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                pBtn.Text = p.Name
                pBtn.TextColor3 = Color3.new(1, 1, 1)
                pBtn.Font = Enum.Font.SourceSansBold
                pBtn.TextSize = 13
                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
                
                pBtn.MouseButton1Click:Connect(function()
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        manualSelectedTarget = p.Character
                        TargetInfoFrame.Visible = true
                        targetDropdownBtn.Text = p.Name
                    end
                    playerListFrame.Visible = false
                end)
            end
        end
        playerListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 34)
    end
end)

