-- Hàm tự động tìm mục tiêu gần nhất
local function FindNearestTarget()
    local shortestDistance = 500
    local targetPlayer = nil
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local distance = (player.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        targetPlayer = player.Character
                    end
                end
            end
        end
    end
    return targetPlayer
end

local orbitAngle = 0
local jarTime = 0

-- Vòng lặp xử lý tính năng liên tục
RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if isNoclip then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        if isESP then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and not p.Character:FindFirstChild("AK_ESP") then
                    local hl = Instance.new("Highlight", p.Character)
                    hl.Name = "AK_ESP"
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                end
            end
        end

        if isJarAnimation then
            hum.PlatformStand = true
            jarTime = jarTime + (dt * jarSpeed)
            local basePos = hrp.Position
            local pushPull = math.sin(jarTime) * 1.8
            local tilt = math.rad(55) + math.sin(jarTime * 2) * 0.4
            hrp.CFrame = CFrame.new(basePos) * CFrame.Angles(tilt, 0, 0) + Vector3.new(0, pushPull * 0.2, 0)
        end

        if isFly then
            hum.PlatformStand = true
            if not flyBodyVelocity or not flyBodyVelocity.Parent then
                flyBodyVelocity = Instance.new("BodyVelocity")
                flyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                flyBodyVelocity.Parent = hrp
            end
            if not flyBodyGyro or not flyBodyGyro.Parent then
                flyBodyGyro = Instance.new("BodyGyro")
                flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                flyBodyGyro.Parent = hrp
            end
            flyBodyVelocity.Velocity = Camera.CFrame.LookVector * flySpeed
            flyBodyGyro.CFrame = Camera.CFrame
        else
            if not isJarAnimation then
                if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
                if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
            end
            
            local activeTarget = manualSelectedTarget
            if not activeTarget or not activeTarget:FindFirstChild("HumanoidRootPart") or activeTarget.Humanoid.Health <= 0 then
                activeTarget = FindNearestTarget()
            end

            if (isAttach or isOrbit) and activeTarget and activeTarget:FindFirstChild("HumanoidRootPart") then
                local enemyHrp = activeTarget.HumanoidRootPart
                local enemyHum = activeTarget:FindFirstChildOfClass("Humanoid")
                local enemyPlayer = Players:GetPlayerFromCharacter(activeTarget)
                
                if enemyPlayer and enemyHum then
                    local dist = math.floor((enemyHrp.Position - hrp.Position).Magnitude)
                    local hpPercent = math.floor((enemyHum.Health / enemyHum.MaxHealth) * 100)
                    TargetNameLabel.Text = "Target: " .. enemyPlayer.Name
                    TargetDistLabel.Text = "Distance: " .. dist .. " studs | HP: " .. hpPercent .. "%"
                    TargetInfoFrame.Visible = true
                end
                
                Camera.CameraType = Enum.CameraType.Scriptable
                hum.PlatformStand = true
                
                if isAttach then
                    hrp.CFrame = enemyHrp.CFrame * CFrame.new(0, 0, attachDistance)
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(hrp.Position - (enemyHrp.CFrame.LookVector * 6) + Vector3.new(0, 2, 0), enemyHrp.Position), 0.3)
                elseif isOrbit then
                    orbitAngle = orbitAngle + (orbitSpeed * dt * 5)
                    local offsetX = math.cos(orbitAngle) * orbitDistance
                    local offsetZ = math.sin(orbitAngle) * orbitDistance
                    local orbitPos = enemyHrp.Position + Vector3.new(offsetX, 2, offsetZ)
                    
                    hrp.CFrame = CFrame.new(orbitPos, enemyHrp.Position)
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(orbitPos - ((enemyHrp.Position - orbitPos).Unit * 8) + Vector3.new(0, 3, 0), enemyHrp.Position), 0.3)
                end
            elseif isSpecTarget and activeTarget and activeTarget:FindFirstChild("HumanoidRootPart") then
                TargetInfoFrame.Visible = true
                Camera.CameraType = Enum.CameraType.Scriptable
                if hum.PlatformStand and not isJarAnimation then hum.PlatformStand = false end
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, activeTarget.HumanoidRootPart.Position + Vector3.new(0, 1, 0)), 0.3)
            else
                TargetInfoFrame.Visible = false
                if hum and hum.PlatformStand and not isJarAnimation and not isFly then
                    hum.PlatformStand = false
                end
                if Camera.CameraType == Enum.CameraType.Scriptable then
                    Camera.CameraType = Enum.CameraType.Custom
                end
            end
        end
    end
end)
